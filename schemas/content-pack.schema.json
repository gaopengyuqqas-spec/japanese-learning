{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-pack.schema.json",
  "title": "Nihongo Lab Content Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "packType",
    "contentVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "packId": {
      "type": "string"
    },
    "packType": {
      "enum": [
        "kanji",
        "vocabulary",
        "dialogue",
        "grammar",
        "mistake",
        "synonym"
      ]
    },
    "contentVersion": {
      "type": "string"
    },
    "items": {
      "type": "array"
    }
  }
}
